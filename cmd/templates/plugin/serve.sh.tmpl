#!/usr/bin/env bash
# serve.sh — serves dist/ (built by pack.sh) as a static local plugin source
# at http://127.0.0.1:8767/ — index.json plus the {{.Slug}}-*.tar.gz package.
# Point an imported plugin source's index_url at
# http://127.0.0.1:8767/index.json to exercise the install gateway end to
# end against this plugin.
set -euo pipefail

cd "$(dirname "$0")/dist" && python3 -m http.server 8767
