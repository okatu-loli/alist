		Provenance: ext.Provenance{
			Source:  "community",
			License: "MIT",
		},
		Permissions: ext.Permissions{
			Filesystem: "none",
		},
		Info: &ext.Info{
			Config: ext.DriverConfig{
				Name: {{printf "%q" .Name}},
{{- if .HasRootFolderID}}
				DefaultRoot: "0",
{{- end}}
			},
			Additional: []ext.Item{
{{- range .Fields}}
				{Name: {{printf "%q" .Name}}, Type: "string"{{if eq .Name "root_folder_id"}}, Default: "0"{{end}}},
{{- end}}
			},
		},
	}
}

